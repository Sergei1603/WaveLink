<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Debug-сборка ходит на dev-сервер по plain HTTP: это может быть 10.0.2.2 (алиас
         хостовой машины в эмуляторе), localhost, LAN-адрес рабочей машины или прод-IP.
         Перечислить их через <domain> нельзя — подсети там не поддерживаются, элемент
         принимает только конкретное имя хоста, — поэтому в debug cleartext разрешён
         целиком. Наружу такая сборка не уходит; release использует
         app/src/main/res/xml/network_security_config.xml, где разрешён ровно один хост. -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
