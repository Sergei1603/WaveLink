# Скопируй в .env.prod и подставь свои значения. .env.prod НЕ коммитить.

# --- PostgreSQL ---
POSTGRES_DB=wavelink
POSTGRES_USER=wavelink
POSTGRES_PASSWORD=ЗАМЕНИ_на_длинный_пароль

# --- MinIO (локальное S3-хранилище) ---
MINIO_ROOT_USER=wavelink
MINIO_ROOT_PASSWORD=ЗАМЕНИ_на_длинный_пароль_минимум_8_символов

# --- JWT --- сгенерируй: openssl rand -base64 48
JWT_SECRET=ЗАМЕНИ_секрет_минимум_32_символа

# --- Telegram (необязательно) ---
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
